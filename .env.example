MONITOR_DATA_DIR=data
MONITOR_AI_BASE_URL=https://api.aitunnel.ru/v1
# Uncomment after placing your API key in a local file (never commit it).
# MONITOR_AI_KEY_FILE=secrets/aitunnel.key
MONITOR_AI_MODEL=gpt-4.1-mini
MONITOR_VISION_MODEL=gpt-4.1
MONITOR_AI_ENABLED=false
# Automatically assess book variants after import, before page checks.
MONITOR_AI_AUTO_GROUPING=true
MONITOR_GROUPING_BATCH_SIZE=10
MONITOR_AI_DAILY_BUDGET_RUB=10
MONITOR_AI_JOB_BUDGET_RUB=5
MONITOR_MIN_BALANCE_RUB=20
MONITOR_CONCURRENCY=3
MONITOR_DOMAIN_DELAY=2
MONITOR_MAX_ATTEMPTS=3
MONITOR_BROWSER_ENABLED=true
MONITOR_REQUEST_TIMEOUT=20
# For providers other than AI Tunnel: blank balance path; configure prices explicitly.
# MONITOR_AI_BALANCE_PATH=
# MONITOR_AI_PROMPT_PRICE=80
# MONITOR_AI_COMPLETION_PRICE=320
